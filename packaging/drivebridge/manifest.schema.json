{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriveBridge payload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "platform",
    "architecture",
    "go_version",
    "tools",
    "runtime",
    "mount",
    "mount_engine",
    "signature",
    "native_verification",
    "release_blockers",
    "licenses",
    "files",
    "vendor_metadata",
    "upgrade_guard",
    "native_login"
  ],
  "properties": {
    "edition": {"enum": ["feishu", "full"]},
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "DriveBridge"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "platform": {
      "enum": [
        "darwin",
        "windows",
        "linux"
      ]
    },
    "architecture": {
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "go_version": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "cli",
        "node"
      ]
    },
    "mount": {
      "type": "boolean"
    },
    "mount_engine": {
      "enum": [
        "cmount",
        "mount2",
        "none"
      ]
    },
    "signature": {
      "enum": [
        "signed",
        "unsigned_test"
      ]
    },
    "native_verification": {
      "const": "not_verified"
    },
    "release_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "pattern": "^licenses/[^/]+$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.@ /-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "vendor_metadata": {
      "type": "object",
      "required": [
        "embedded_ci_prefixes",
        "policy"
      ]
    },
    "upgrade_guard": {
      "enum": [
        "process_check_only",
        "lifecycle_lease_unverified",
        "lifecycle_lease"
      ]
    },
    "cli_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "upstream_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "desktop": {
      "type": "boolean"
    },
    "native_login": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "provider",
        "minimum_os",
        "verification"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "WKWebView",
            "WebView2",
            "unavailable"
          ]
        },
        "minimum_os": {
          "enum": [
            "14.0",
            "10.0.17763",
            null
          ]
        },
        "verification": {
          "const": "not_verified"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_runtime",
        "verification"
      ],
      "properties": {
        "git_runtime": {
          "type": "boolean"
        },
        "verification": {
          "enum": [
            "not_verified",
            "verified"
          ]
        },
        "git_version": {
          "type": "string"
        }
      }
    }
  }
}
