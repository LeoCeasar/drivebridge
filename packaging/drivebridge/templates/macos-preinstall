#!/bin/sh
set -eu
# Trusted candidate is embedded by pkgbuild. Never execute an environment-selected
# helper. Require the wrapper even for fresh installs to avoid detection races.
# If Installer changes OS-user identity or strips the proof, verification fails.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
"$script_dir/drivebridge-install-verifier" feishu maintenance verify
